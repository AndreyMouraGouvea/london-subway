# ---------------------------------------------------------------------------
# Web (Vite) — tudo com prefixo VITE_ é público no bundle.
# O Vite lê este ficheiro da raiz (envDir em apps/web/vite.config.ts).
# Nunca colocar aqui a app_key da TfL ou a service_role key do Supabase.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# ---------------------------------------------------------------------------
# API local (apps/api)
# ---------------------------------------------------------------------------
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173

# TfL Unified API — somente no backend.
TFL_APP_KEY=
TFL_API_BASE_URL=https://api.tfl.gov.uk
TFL_TIMEOUT_MS=8000
TFL_MAX_RETRIES=2

# Cache / retenção (segundos)
CACHE_TTL_STATUS_SECONDS=60
CACHE_TTL_DISRUPTIONS_SECONDS=60
CACHE_TTL_ARRIVALS_SECONDS=45
CACHE_TTL_STATIC_SECONDS=86400
CACHE_STALE_MAX_AGE_SECONDS=86400

# ---------------------------------------------------------------------------
# Supabase (server-side)
# Em produção, SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetados
# automaticamente nas Edge Functions. Localmente, usa .env.local.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Aliases para `supabase functions serve` local (o CLI ignora prefixo SUPABASE_)
LOCAL_SUPABASE_URL=
LOCAL_SUPABASE_SERVICE_ROLE_KEY=

# Segredo para jobs internos (Fase 2)
CRON_SECRET=
# Alias usado pelo runtime local e pelo harness Node
LDT_CRON_SECRET=
